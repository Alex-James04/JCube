<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.AppController">
    <top>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="top-nav">
            <padding>
                <Insets top="10" right="12" bottom="10" left="12"/>
            </padding>
            <Button text="←" onAction="#handleBack"/>
            <Button text="Home" onAction="#showHome"/>
            <Button text="Settings" onAction="#showSettings"/>
        </HBox>
    </top>
    <center>
        <StackPane fx:id="contentArea"/>
    </center>
    <bottom>
        <HBox alignment="CENTER" styleClass="bottom-bar">
            <padding>
                <Insets top="4" right="12" bottom="4" left="12"/>
            </padding>
            <Label text="Alex James © 2026" styleClass="label-secondary" style="-fx-font-size: 11px;"/>
        </HBox>
    </bottom>
</BorderPane>
