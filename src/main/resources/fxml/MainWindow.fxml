<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.AppController">
    <left>
        <VBox spacing="8" prefWidth="160">
            <padding>
                <Insets top="16" right="12" bottom="16" left="12"/>
            </padding>
            <Button text="Cubes" maxWidth="Infinity" onAction="#showCubes"/>
            <Button text="Settings" maxWidth="Infinity" onAction="#showSettings"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea"/>
    </center>
</BorderPane>
