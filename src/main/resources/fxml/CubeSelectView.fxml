<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.CubeViewController">
    <top>
        <HBox spacing="8" alignment="CENTER_LEFT" minHeight="60" prefHeight="60" maxHeight="60">
            <padding>
                <Insets top="0" right="16" bottom="0" left="16"/>
            </padding>
            <Label text="JCube" styleClass="app-title"/>
        </HBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.4">
            <VBox spacing="8">
                <padding>
                    <Insets top="12" right="8" bottom="12" left="12"/>
                </padding>
                <Button text="Add Cube" maxWidth="Infinity" onAction="#handleAddCube"/>
                <ListView fx:id="cubeListView" VBox.vgrow="ALWAYS"/>
            </VBox>
            <VBox fx:id="detailPane" spacing="20" alignment="CENTER">
                <padding>
                    <Insets top="12" right="24" bottom="12" left="24"/>
                </padding>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
